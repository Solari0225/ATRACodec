# Optional CMake toolchain using a user-provided Zig. No fixed workspace paths.
set(SONY_ZIG_TARGET "windows-x64" CACHE STRING "windows-x64, macos-arm64, or macos-x64")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SONY_ZIG_EXECUTABLE SONY_ZIG_TARGET)
if(NOT SONY_ZIG_EXECUTABLE)
    find_program(SONY_ZIG_EXECUTABLE NAMES zig REQUIRED)
endif()
set(SONY_ZIG_EXECUTABLE "${SONY_ZIG_EXECUTABLE}" CACHE FILEPATH "Zig executable")
if(SONY_ZIG_TARGET STREQUAL "windows-x64")
    set(CMAKE_SYSTEM_NAME Windows)
    set(CMAKE_SYSTEM_PROCESSOR AMD64)
    set(_sony_triple x86_64-windows-gnu)
elseif(SONY_ZIG_TARGET STREQUAL "macos-arm64")
    set(CMAKE_SYSTEM_NAME Darwin)
    set(CMAKE_SYSTEM_PROCESSOR arm64)
    set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "")
    set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0 CACHE STRING "")
    set(_sony_triple aarch64-macos.11.0)
elseif(SONY_ZIG_TARGET STREQUAL "macos-x64")
    set(CMAKE_SYSTEM_NAME Darwin)
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "")
    set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0 CACHE STRING "")
    set(_sony_triple x86_64-macos.11.0)
else()
    message(FATAL_ERROR "Unknown SONY_ZIG_TARGET: ${SONY_ZIG_TARGET}")
endif()
set(CMAKE_C_COMPILER "${SONY_ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${SONY_ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_C_COMPILER_TARGET "${_sony_triple}")
set(CMAKE_CXX_COMPILER_TARGET "${_sony_triple}")
set(CMAKE_AR "${SONY_ZIG_EXECUTABLE}")
set(CMAKE_RANLIB "${SONY_ZIG_EXECUTABLE}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/zig-rules.cmake")
foreach(_language C CXX)
    set(CMAKE_${_language}_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
    set(CMAKE_${_language}_ARCHIVE_APPEND "<CMAKE_AR> ar q <TARGET> <LINK_FLAGS> <OBJECTS>")
    set(CMAKE_${_language}_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
endforeach()
